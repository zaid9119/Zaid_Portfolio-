<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>A Special Invitation ✨</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Montserrat:wght@400;500;600&display=swap');
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Montserrat,sans-serif;background:#efe5d2;color:#30251c}
body{overflow-x:hidden}
.wrap{min-height:100vh;display:grid;place-items:center;padding:28px 15px;position:relative;
background:radial-gradient(circle at 15% 15%,#fff9eb 0 12%,transparent 35%),radial-gradient(circle at 90% 85%,#e7d4b8 0 10%,transparent 35%),#efe5d2}

.card{width:min(92vw,520px);min-height:720px;background:#fbf7ed;border:1px solid #c8a96a;box-shadow:0 25px 70px #513b241f;position:relative;overflow:hidden;text-align:center;padding:55px 35px 40px;transition:.8s}
.card:before,.card:after{content:"";position:absolute;width:125px;height:125px;border:1px solid #c8a96a;transform:rotate(45deg);opacity:.65;pointer-events:none;z-index:2}
.card:before{top:-70px;left:-70px}.card:after{bottom:-70px;right:-70px}

.orn{font-size:28px;color:#a57b37;letter-spacing:12px}
.tiny{font-size:10px;letter-spacing:.38em;text-transform:uppercase;color:#8a6a3b;margin:26px 0 14px}
h1,h2{font-family:'Cormorant Garamond',serif}
.invite h1{font-size:64px;line-height:.9;margin:10px 0;color:#3b2b20}
.invite h1 span{font-size:30px;font-weight:500;display:block;letter-spacing:.08em;margin:15px 0}
.invite p{font-family:'Cormorant Garamond',serif;font-size:25px;line-height:1.25;color:#685441}
.line{height:1px;background:#c8a96a;width:75px;margin:25px auto}
.seal{width:80px;height:80px;border:1px solid #c8a96a;border-radius:50%;display:grid;place-items:center;margin:35px auto 20px;font-family:'Cormorant Garamond';font-size:27px;color:#9a7032;background:#f8f0df}
.open{margin-top:35px;border:1px solid #a57b37;background:#a57b37;color:#fffaf0;padding:14px 25px;letter-spacing:.15em;text-transform:uppercase;font-size:11px;cursor:pointer;transition:.3s}
.open:hover{transform:translateY(-2px);background:#896329}
.hidden{display:none}
.surprise{animation:reveal .9s ease both}
.surprise h2{font-size:54px;line-height:.9;margin:10px 0 18px}
.surprise .subtitle{font-size:12px;letter-spacing:.25em;text-transform:uppercase;color:#8a6a3b}
.dest{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:28px 0}
.place{height:155px;background-size:cover;background-position:center;position:relative;display:flex;align-items:end;padding:13px;color:white;text-align:left}
.place:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent,#000b)}
.place strong{position:relative;z-index:1;font-family:'Cormorant Garamond';font-size:25px}
.final{font-family:'Cormorant Garamond';font-size:24px;line-height:1.2}
.details{border-top:1px solid #d8c49d;border-bottom:1px solid #d8c49d;padding:18px;margin:25px 0;font-size:11px;line-height:2;letter-spacing:.08em}
.again{background:transparent;color:#76582c;border:0;font-size:10px;text-decoration:underline;cursor:pointer;margin-top:15px}
.confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:40}
.confetti i{position:absolute;top:-20px;width:7px;height:13px;background:#b18a49;animation:fall 3s linear forwards}

/* ===== Travel window transition ===== */
.journey-stage{
  position:absolute;inset:0;z-index:20;
  background:#1a1410;
  display:none;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  overflow:hidden;
}
.journey-stage.active{display:flex}

.cabin{
  position:absolute;inset:0;
  opacity:0;
  pointer-events:none;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
}
.cabin.show{opacity:1;animation:cabinIn .7s ease both}
.cabin.hide{animation:cabinOut .55s ease both}

.mode-tag{
  position:absolute;top:28px;left:0;right:0;
  text-align:center;
  font-size:10px;
  letter-spacing:.42em;
  text-transform:uppercase;
  color:#e8d4a8;
  z-index:5;
  text-shadow:0 2px 10px #0008;
}
