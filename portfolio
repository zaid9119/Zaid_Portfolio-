$("profileUpload").onchange = (e) => {
  const f = e.target.files[0];
  if (!f) return;
  const r = new FileReader();
  r.onload = () => {
    localStorage.setItem("zaidProfile", r.result);
    loadProfile();
  };
  r.readAsDataURL(f);
};

$("thumbUpload").onchange = (e) => {
  const files = [...e.target.files];
  let current = JSON.parse(localStorage.getItem("zaidThumbs") || "[]");
  files.forEach((f, i) => {
    const r = new FileReader();
    r.onload = () => {
      current[i] = r.result;
      localStorage.setItem("zaidThumbs", JSON.stringify(current));
      showThumbPreviews();
      renderPortfolio();
    };
    r.readAsDataURL(f);
  });
};

function showThumbPreviews() {
