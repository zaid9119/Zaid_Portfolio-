const $ = id => document.getElementById(id);

/* ===================== RENDER FUNCTIONS ===================== */
function renderServices() {
  $("servicesGrid").innerHTML = services.map(x => `
    <article class="service-card glass rounded-3xl p-6 border border-white/10">
      <div class="text-4xl font-black text-white/15">${x[0]}</div>
      <h3 class="mt-10 text-lg font-bold">${x[1]}</h3>
      <p class="mt-3 text-sm leading-6 text-zinc-500">${x[2]}</p>
      <div class="mt-8 text-[11px] tracking-widest text-zinc-400">EXPLORE ↗</div>
    </article>
  `).join("");
}

function renderProcess() {
  $("processGrid").innerHTML = process.map(x => `
    <div class="rounded-2xl border border-white/10 p-6 hover:border-violet-400/30 transition">
      <div class="text-5xl font-black text-white/12">${x[0]}</div>
      <h3 class="mt-8 font-bold tracking-wide">${x[1]}</h3>
      <p class="mt-3 text-sm leading-6 text-zinc-500">${x[2]}</p>
    </div>
  `).join("");
}

function renderTools() {
  $("toolsGrid").innerHTML = tools.map(x => `
    <div class="glass rounded-full px-6 py-3.5 text-sm font-medium tracking-wide">${x}</div>
  `).join("");
}

function getProjects() {
  const saved = JSON.parse(localStorage.getItem("zaidThumbs") || "[]");
  return projects.map((p, i) => {
    const copy = [...p];
    if (saved[i]) copy[3] = saved[i];
    return copy;
  });
}

function renderFilters() {
  const cats = ["ALL", "GAMING", "EDUCATION", "ISLAMIC", "MOTIVATION", "BUSINESS", "FINANCE", "OTHER"];
  $("filters").innerHTML = cats.map((c, i) => `
    <button data-cat="${c}" class="filter ${i === 0 ? 'active' : ''} rounded-full border border-white/10 px-4 py-2 text-[10px] tracking-widest text-zinc-400 transition hover:border-white/30">
      ${c}
    </button>
  `).join("");
  document.querySelectorAll(".filter").forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll(".filter").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderPortfolio(btn.dataset.cat);
    };
  });
}

function renderPortfolio(cat = "ALL") {
  const all = getProjects();
  const arr = all.filter(p => {
    if (cat === "ALL") return true;
    const upper = p[1].toUpperCase();
    if (cat === "OTHER") {
      return !["GAMING", "EDUCATION", "ISLAMIC", "MOTIVATION", "BUSINESS", "FINANCE"].includes(upper);
    }
    return upper === cat;
  });

  $("portfolioGrid").innerHTML = arr.map((p) => {
    const realIndex = projects.findIndex(orig => orig[0] === p[0]);
    return `
      <article class="project glass relative overflow-hidden rounded-3xl cursor-pointer group" data-index="${realIndex}">
        <div class="relative aspect-video overflow-hidden">
          <img src="${p[3]}" alt="${p[0]}" class="h-full w-full object-cover" loading="lazy" onerror="this.style.opacity=.2">
          <div class="absolute inset-x-0 bottom-0 z-10 p-5">
            <div class="text-[10px] tracking-[.25em] text-zinc-400">${p[1]}</div>
            <h3 class="mt-2 text-xl font-bold">${p[0]}</h3>
            <p class="mt-1 text-sm text-zinc-400 line-clamp-2">${p[2]}</p>
          </div>
        </div>
      </article>
    `;
  }).join("");

  document.querySelectorAll(".project").forEach(el => {
    el.onclick = () => openProject(Number(el.dataset.index));
    // Simple tilt on mouse move
    el.addEventListener("mousemove", (e) => {
      const rect = el.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const midX = rect.width / 2;
      const midY = rect.height / 2;
      const rotY = ((x - midX) / midX) * 8;
      const rotX = ((midY - y) / midY) * 8;
      el.style.transform = `perspective(900px) rotateX(${rotX}deg) rotateY(${rotY}deg) scale(1.02)`;
    });
    el.addEventListener("mouseleave", () => {
      el.style.transform = "perspective(900px) rotateX(0) rotateY(0) scale(1)";
    });
  });
}

function openProject(i) {
  const p = getProjects()[i];
  if (!p) return;
  $("modalImg").src = p[3];
  $("modalCat").textContent = p[1];
  $("modalTitle").textContent = p[0];
  $("modalDesc").textContent = p[2];
  $("projectModal").classList.add("open");
  document.body.style.overflow = "hidden";
}

$("closeProject").onclick = () => {
  $("projectModal").classList.remove("open");
  document.body.style.overflow = "";
};

